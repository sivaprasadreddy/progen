name: Build

env:
  DOCKERHUB_USERNAME: ${{"{{"}} secrets.DOCKERHUB_USERNAME {{"}}"}}
  DOCKERHUB_TOKEN: ${{"{{"}} secrets.DOCKERHUB_TOKEN {{"}}"}}

on:
  push:
    branches: [ "main", "dev", "release", "fix/*", "feat/*" ]
    paths-ignore:
      - "*.md"
      - "docs/**"
      - ".gitignore"
      - ".gitattributes"
      - "README.md"
      - "LICENSE"
      - "renovate.json"
      {{- if .TaskfileSupport }}
      - ".sdkmanrc"
      - "Taskfile.yml"
      {{- end }}

jobs:
  build:
    name: Build
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@{{ .CheckoutActionVersion }}
      {{- if .TaskfileSupport }}

      - name: Set up JDK
        uses: actions/setup-java@{{ .SetupJavaActionVersion }}
        with:
          java-version-file: .sdkmanrc
          {{- if eq .BuildTool "Maven" }}
          cache: 'maven'
          {{- end }}
          {{- if eq .BuildTool "Gradle" }}
          cache: 'gradle'
          {{- end }}

      - name: Install Task
        uses: go-task/setup-task@{{ .SetupTaskActionVersion }}
      {{- end }}
      {{- if .MiseSupport }}

      - name: Install mise and tools
        uses: jdx/mise-action@{{ .MiseActionVersion }}
      {{- end }}

     {{- if eq .BuildTool "Maven" }}

      - name: Make Maven wrapper executable
        run: chmod +x mvnw
     {{- end }}

     {{- if eq .BuildTool "Gradle" }}

      - name: Make Gradle wrapper executable
        run: chmod +x gradlew
     {{- end }}

      - name: Build
        {{- if .TaskfileSupport }}
        run: task verify
        {{- end }}
        {{- if .MiseSupport }}
        run: mise run verify
        {{- end }}

      - if: ${{"{{"}} github.ref == 'refs/heads/release' {{"}}"}}
        name: Login to Docker Hub
        uses: docker/login-action@{{ .DockerLoginActionVersion }}
        with:
          username: ${{"{{"}} secrets.DOCKERHUB_USERNAME {{"}}"}}
          password: ${{"{{"}} secrets.DOCKERHUB_TOKEN {{"}}"}}

      - if: ${{"{{"}} github.ref == 'refs/heads/release' {{"}}"}}
        name: Build and Publish Docker Image
        {{- if .TaskfileSupport }}
        run: task push_image
        {{- end }}
        {{- if .MiseSupport }}
        run: mise run push_image
        {{- end }}
