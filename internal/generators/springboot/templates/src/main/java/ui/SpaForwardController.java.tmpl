package {{ .BasePackage }}.ui;

import org.springframework.stereotype.Controller;
import org.springframework.web.bind.annotation.GetMapping;

/**
 * Serve the {{ .Frontend }} single page application's index.html for all requests
 * that are not relevant for the backend, so that client-side routes work on page refresh.
 */
@Controller
class SpaForwardController {

    @GetMapping("/{path:^(?!API|public|static|assets|media|swagger|.*\\..*$).*$}/**")
    String redirect() {
        return "forward:/index.html";
    }
}
