apiVersion: v1
kind: Service
metadata:
  name: {{ .ArtifactID }}-rabbitmq-svc
spec:
  type: NodePort
  selector:
    app: {{ .ArtifactID }}-rabbitmq-pod
  ports:
    - name: rabbitmq-port-mapping
      port: 5672
      targetPort: 5672
      protocol: TCP
    - name: rabbitmq-gui-port-mapping
      port: 15672
      targetPort: 15672
      protocol: TCP
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ .ArtifactID }}-rabbitmq-deployment
spec:
  selector:
    matchLabels:
      app: {{ .ArtifactID }}-rabbitmq-pod
  strategy:
    type: Recreate
  template:
    metadata:
      labels:
        app: {{ .ArtifactID }}-rabbitmq-pod
    spec:
      containers:
        - name: rabbitmq
          image: "{{ .RabbitMQImage }}"
          ports:
            - name: rabbitmq
              containerPort: 5672
            - name: rabbitmq-admin
              containerPort: 15672
          env:
            - name: RABBITMQ_DEFAULT_USER
              value: guest
            - name: RABBITMQ_DEFAULT_PASS
              value: guest
