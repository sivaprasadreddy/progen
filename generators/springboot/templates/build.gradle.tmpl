plugins {
	id "java"
	id "jacoco"
	id "org.springframework.boot" version "{{ .SpringBootVersion }}"
    id "io.spring.dependency-management" version "{{ .GradleDependencyMgmtVersion }}"
    id "com.gorylenko.gradle-git-properties" version "{{ .GradleGitPropertiesVersion }}"
    id "com.diffplug.spotless" version "{{ .SpotlessGradlePluginVersion }}"
    {{- if eq .AppType "Spring Boot + Angular Full Stack" }}
    id "com.github.node-gradle.node" version "{{ .GradleNodePluginVersion }}"
    {{ end }}
}

group = "{{ .GroupID }}"
version = "{{ .AppVersion }}"

java {
  toolchain {
    languageVersion = JavaLanguageVersion.of({{ .JavaVersion }})
  }
}

configurations {
  compileOnly {
    extendsFrom annotationProcessor
  }
}

repositories {
	mavenCentral()
}

ext {
{{- if .RestApiEnabled }}
  set("springdocOpenapiVersion", "{{ .SpringdocOpenapiVersion }}")
{{- end }}
{{- if .SpringCloudAWSSupport }}
  set("awspringVersion", "{{ .SpringCloudAWSVersion }}")
  set("bootTcFlociVersion", "{{ .SpringBootFlociTcVersion }}")
{{- end }}
  set("springModulithVersion", "{{ .SpringModulithVersion }}")
{{- if .ThymeleafSupport }}
  set("fontawesomeVersion", "{{ .FontAwesomeVersion }}")
{{- end }}
{{- if .HTMXSupport }}
  set("htmxVersion", "{{ .HtmxVersion }}")
{{- end }}
{{- if and .ThymeleafSupport .HTMXSupport }}
  set("htmxSpringBootThymeleafVersion", "{{ .HtmxSpringBootThymeleafVersion }}")
{{- end }}
{{- if .RestApiEnabled }}
  set("jjwtVersion", "{{ .JjwtVersion }}")
{{- end }}
{{- if .EmailSupport }}
  set("tcMailpitVersion", "{{ .TcMailpitVersion }}")
{{- end }}
{{- if .OpenTelemetrySupport }}
  set("datasourceMicrometerSpringBootVersion", "{{ .DatasourceMicrometerSpringBootVersion }}")
{{ end }}
  set("bootUIVersion", "{{ .BootUIVersion }}")
  set("palantirJavaFormatVersion", "{{ .PalantirJavaFormatVersion }}")
  set("archunitVersion", "{{ .ArchunitVersion }}")
  set("taikaiVersion", "{{ .TaikaiVersion }}")
}

dependencies {
    implementation "org.springframework.boot:spring-boot-starter-webmvc"
    implementation "org.springframework.boot:spring-boot-starter-validation"
    implementation "org.springframework.boot:spring-boot-starter-actuator"
    {{- if .OpenTelemetrySupport }}
    implementation "org.springframework.boot:spring-boot-starter-opentelemetry"
    implementation "io.opentelemetry.instrumentation:opentelemetry-logback-appender-1.0:{{ .OpenTelemetryLogbackAppenderVersion }}"
    implementation "io.opentelemetry:opentelemetry-api-incubator:{{ .OpenTelemetryAPIIncubatorVersion }}"
    implementation "net.ttddyy.observation:datasource-micrometer-spring-boot:${datasourceMicrometerSpringBootVersion}"
    {{ end }}
    implementation "org.springframework.boot:spring-boot-starter-security"
    {{- if .ThymeleafSupport }}
    implementation "org.springframework.boot:spring-boot-starter-thymeleaf"
    implementation "nz.net.ultraq.thymeleaf:thymeleaf-layout-dialect"
    implementation "org.thymeleaf.extras:thymeleaf-extras-springsecurity6"
    {{- if .HTMXSupport }}
    implementation "io.github.wimdeblauwe:htmx-spring-boot-thymeleaf:${htmxSpringBootThymeleafVersion}"
    {{- end }}
    {{- end }}
    {{- if .RestApiEnabled }}
    implementation "org.springdoc:springdoc-openapi-starter-webmvc-ui:${springdocOpenapiVersion}"
    {{- end }}
    {{- if eq .PersistenceType "Spring Data JPA" }}
    implementation "org.springframework.boot:spring-boot-starter-data-jpa"
    {{- end }}
    {{- if eq .PersistenceType "Spring JdbcClient" }}
    implementation "org.springframework.boot:spring-boot-starter-jdbc"
    {{- end }}
    {{- if eq .PersistenceType "jOOQ" }}
    implementation "org.springframework.boot:spring-boot-starter-jooq"
    {{- end }}
    {{- if eq .DbType "PostgreSQL" }}
    runtimeOnly "org.postgresql:postgresql"
    {{- end }}
    {{- if eq .DbType "MySQL" }}
    runtimeOnly "com.mysql:mysql-connector-j"
    {{- end }}
    {{- if eq .DbType "MariaDB" }}
    runtimeOnly "org.mariadb.jdbc:mariadb-java-client"
    {{- end }}
    {{- if eq .DbMigrationTool "Flyway"}}
    implementation "org.springframework.boot:spring-boot-starter-flyway"
    {{- if eq .DbType "PostgreSQL" }}
    runtimeOnly "org.flywaydb:flyway-database-postgresql"
    {{- end }}
    {{- if or (eq .DbType "MySQL") (eq .DbType "MariaDB") }}
    implementation "org.flywaydb:flyway-mysql"
    {{- end }}
    {{- end }}
    {{- if eq .DbMigrationTool "Liquibase"}}
    implementation "org.springframework.boot:spring-boot-starter-liquibase"
    {{- end }}
    implementation "org.springframework.modulith:spring-modulith-starter-core"
    implementation "org.springframework.modulith:spring-modulith-docs"
    runtimeOnly "org.springframework.modulith:spring-modulith-actuator"
    {{- if .SpringCloudAWSSupport }}
    implementation "io.awspring.cloud:spring-cloud-aws-starter"
    implementation "io.awspring.cloud:spring-cloud-aws-starter-s3"
    {{- end }}
    {{- if .EmailSupport }}
    implementation "org.springframework.boot:spring-boot-starter-mail"
    {{- end }}
    {{- if .RabbitMQSupport }}
    implementation "org.springframework.boot:spring-boot-starter-amqp"
    {{- end }}
    {{- if .RedisCachingSupport }}
    implementation "org.springframework.boot:spring-boot-starter-data-redis"
    implementation "org.springframework.boot:spring-boot-starter-cache"
    {{- end }}
    {{- if .ThymeleafSupport }}
    implementation "org.webjars:webjars-locator-lite"
    implementation "org.webjars:font-awesome:${fontawesomeVersion}"
    {{- end }}
    {{- if .HTMXSupport }}
    implementation "org.webjars.npm:htmx.org:${htmxVersion}"
    {{- end }}
    {{- if .RestApiEnabled }}
    implementation "io.jsonwebtoken:jjwt-api:${jjwtVersion}"
    implementation "io.jsonwebtoken:jjwt-impl:${jjwtVersion}"
    implementation "io.jsonwebtoken:jjwt-jackson:${jjwtVersion}"
    {{- end }}
    implementation "com.julien-dubois.bootui:bootui-spring-boot-starter:${bootUIVersion}"

    developmentOnly "org.springframework.boot:spring-boot-devtools"
    annotationProcessor "org.springframework.boot:spring-boot-configuration-processor"
    developmentOnly "org.springframework.boot:spring-boot-docker-compose"

    testRuntimeOnly "org.junit.platform:junit-platform-launcher"
    testImplementation "org.springframework.boot:spring-boot-starter-webmvc-test"
    testImplementation "org.springframework.boot:spring-boot-starter-validation-test"
    testImplementation "org.springframework.boot:spring-boot-starter-actuator-test"
    {{- if eq .PersistenceType "Spring Data JPA" }}
    testImplementation "org.springframework.boot:spring-boot-starter-data-jpa-test"
    {{- end }}
    {{- if eq .PersistenceType "Spring JdbcClient" }}
    testImplementation "org.springframework.boot:spring-boot-starter-jdbc-test"
    {{- end }}
    {{- if eq .PersistenceType "jOOQ" }}
    implementation "org.springframework.boot:spring-boot-starter-jooq-test"
    {{- end }}

    {{- if eq .DbMigrationTool "Flyway"}}
    testImplementation "org.springframework.boot:spring-boot-starter-flyway-test"
    {{- end }}
    {{- if eq .DbMigrationTool "Liquibase"}}
    testImplementation "org.springframework.boot:spring-boot-starter-liquibase-test"
    {{- end }}
    testImplementation "org.springframework.boot:spring-boot-starter-security-test"
    {{- if .ThymeleafSupport }}
    testImplementation "org.springframework.boot:spring-boot-starter-thymeleaf-test"
    {{- end }}
    testImplementation "org.springframework.modulith:spring-modulith-starter-test"
    testImplementation "org.springframework.boot:spring-boot-testcontainers"
    testImplementation "org.testcontainers:testcontainers-junit-jupiter"
    {{- if eq .DbType "PostgreSQL" }}
    testImplementation "org.testcontainers:testcontainers-postgresql"
    {{- end }}
    {{- if eq .DbType "MySQL" }}
    testImplementation "org.testcontainers:testcontainers-mysql"
    {{- end }}
    {{- if eq .DbType "MariaDB" }}
    testImplementation "org.testcontainers:testcontainers-mariadb"
    {{- end }}
    {{- if .SpringCloudAWSSupport }}
    testImplementation "io.floci:spring-boot-testcontainers-floci:${bootTcFlociVersion}"
    {{- end }}
    {{- if .EmailSupport }}
    testImplementation "ch.martinelli.oss:testcontainers-mailpit:${tcMailpitVersion}"
    {{- end }}
    {{- if .RabbitMQSupport }}
    testImplementation "org.springframework.boot:spring-boot-starter-amqp-test"
    testImplementation "org.testcontainers:testcontainers-rabbitmq"
    {{- end }}
    {{- if .OpenTelemetrySupport }}
    testImplementation "org.testcontainers:testcontainers-grafana"
    {{ end }}
    testImplementation "org.awaitility:awaitility"
    testImplementation "com.tngtech.archunit:archunit-junit5:${archunitVersion}"
    testImplementation "com.enofex:taikai:${taikaiVersion}"
}

dependencyManagement {
    imports {
        {{- if .SpringCloudAWSSupport }}
        mavenBom "io.awspring.cloud:spring-cloud-aws-dependencies:${awspringVersion}"
        {{- end }}
        mavenBom "org.springframework.modulith:spring-modulith-bom:${springModulithVersion}"
    }
}

{{- if eq .AppType "Spring Boot + Angular Full Stack" }}
node {
    version = "{{ .NodeVersion }}"
    npmVersion = "{{ .NpmVersion }}"

    // Download Node.js instead of requiring it to be installed globally
    download = true

    // frontend/package.json
    nodeProjectDir = file("frontend")

    // Equivalent to frontend-maven-plugin's installDirectory=target
    workDir = file("${buildDir}/nodejs")
    npmWorkDir = file("${buildDir}/npm")

    // Use npm install, matching your Maven configuration
    npmInstallCommand = "install"
}

tasks.register("npmBuild", com.github.gradle.node.npm.task.NpmTask) {
    dependsOn tasks.npmInstall

    npmCommand = ["run", "build"]
}

tasks.named("processResources") {
    dependsOn "npmBuild"

    from("frontend/dist/frontend/browser") {
        into "build/classes/public"
    }
}
{{ end }}

tasks.named("bootBuildImage") {
	imageName = "your_dockerhub_username/{{ .ArtifactID }}"
}

tasks.named("test") {
	useJUnitPlatform()
	finalizedBy tasks.named("jacocoTestReport")
	testLogging {
		events = ["PASSED", "FAILED", "SKIPPED"]
		showStandardStreams = true
		exceptionFormat = "full"
	}
}

tasks.named("jacocoTestReport") {
    dependsOn tasks.named("test")
    reports {
        xml.required = true
    }
}

tasks.named("jacocoTestCoverageVerification") {
    dependsOn tasks.named("test")
    violationRules {
        rule {
            limit {
                counter = "LINE"
                value = "COVEREDRATIO"
                minimum = 0.40
            }
        }
    }
}

tasks.named("check") {
    dependsOn tasks.named("jacocoTestCoverageVerification")
}

gitProperties {
    failOnNoGitDirectory = false
    keys = [
            "git.branch",
            "git.commit.id.abbrev",
            "git.commit.user.name",
            "git.commit.message.full"
    ]
}

spotless {
    java {
        importOrder()
        removeUnusedImports()
        formatAnnotations()
        palantirJavaFormat("${palantirJavaFormatVersion}")
    }
    groovyGradle {
        target "*.gradle"
        greclipse()
    }
}
