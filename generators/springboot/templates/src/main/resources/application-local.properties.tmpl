spring.main.lazy-initialization=true
management.endpoints.web.exposure.include=*
management.endpoint.health.show-details=always
{{- if eq .PersistenceType "Spring Data JPA" }}
spring.jpa.properties.hibernate.generate_statistics=true
spring.jpa.properties.hibernate.log_slow_query=1000
{{- end }}
bootui.enabled=on
bootui.mcp.enabled=on
{{- if .RestApiEnabled }}
springdoc.swagger-ui.enabled=true
{{- end }}
{{- if .SpringCloudAWSSupport }}
spring.cloud.aws.endpoint=http://localhost:4566
spring.cloud.aws.credentials.access-key=test
spring.cloud.aws.credentials.secret-key=test
{{- end }}
{{- if .JTESupport }}
# Hot-reload jte templates from src/main/jte (requires a JDK)
gg.jte.usePrecompiledTemplates=false
gg.jte.developmentMode=true
gg.jte.class-directory=jte-classes
{{- end }}
{{- if .OllamaSupport }}
# Pull the configured Ollama chat model on startup if it is not available locally
spring.ai.ollama.init.pull-model-strategy=when_missing
{{- end }}
