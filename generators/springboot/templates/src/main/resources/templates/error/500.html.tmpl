<!DOCTYPE html>
<html lang="en"
      xmlns:th="http://www.thymeleaf.org"
      xmlns:layout="http://www.ultraq.net.nz/thymeleaf/layout"
      layout:decorate="~{layout}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Server Error</title>
</head>
<body>
<div layout:fragment="content">
    <div class="flex flex-col items-center justify-center min-h-[60vh] text-center">
        <div class="mb-8">
            <i class="fas fa-server text-red-500 text-6xl"></i>
        </div>
        <h1 class="text-4xl font-bold text-gray-900 mb-4">500 - Server Error</h1>
        <p class="text-lg text-gray-600 mb-4">Some error occurred while processing your request.</p>
        <p class="text-md text-gray-500 mb-8">Please try again later.</p>
        <a th:href="@{/}" class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700">
            <i class="fas fa-home mr-2"></i>
            Go to Homepage
        </a>
    </div>
</div>
</body>
</html>