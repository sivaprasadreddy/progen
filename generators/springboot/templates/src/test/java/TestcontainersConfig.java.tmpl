package {{ .BasePackage }};

import static org.testcontainers.utility.DockerImageName.parse;

import org.springframework.boot.test.context.TestConfiguration;
import org.springframework.boot.testcontainers.service.connection.ServiceConnection;
import org.springframework.context.annotation.Bean;
{{- if eq .DbType "PostgreSQL" }}
import org.testcontainers.postgresql.PostgreSQLContainer;
{{- end }}
{{- if eq .DbType "MySQL" }}
import org.testcontainers.mysql.MySQLContainer;
{{- end }}
{{- if eq .DbType "MariaDB" }}
import org.testcontainers.mariadb.MariaDBContainer;
{{ end }}
{{- if .SpringCloudAWSSupport }}
import io.floci.testcontainers.FlociContainer;
import org.testcontainers.containers.BindMode;
{{ end }}
{{- if .EmailSupport }}
import ch.martinelli.oss.testcontainers.mailpit.MailpitContainer;
{{ end }}
{{- if .RabbitMQSupport }}
import org.testcontainers.rabbitmq.RabbitMQContainer;
{{ end }}
{{- if .RedisCachingSupport }}
import org.testcontainers.containers.GenericContainer;
{{ end }}

@TestConfiguration(proxyBeanMethods = false)
public class TestcontainersConfig {

{{- if eq .DbType "PostgreSQL" }}
    @Bean
    @ServiceConnection
    PostgreSQLContainer postgres() {
        return new PostgreSQLContainer(parse("{{ .PostgresImage }}"));
    }
{{- end }}
{{- if eq .DbType "MySQL" }}
    @Bean
    @ServiceConnection
    MySQLContainer mysql() {
        return new MySQLContainer(parse("{{ .MysqlImage }}"));
    }
{{- end }}
{{- if eq .DbType "MariaDB" }}
    @Bean
    @ServiceConnection
    MariaDBContainer mariadb() {
        return new MariaDBContainer(parse("{{ .MariadbImage }}"));
    }
{{- end }}
{{- if .SpringCloudAWSSupport }}
    @Bean
    @ServiceConnection
    FlociContainer flociContainer() {
        return new FlociContainer("{{ .FlociImage }}")
               .withClasspathResourceMapping("/floci-init/ready.d/", "/etc/floci/init/ready.d/", BindMode.READ_ONLY);
    }
{{ end }}
{{- if .EmailSupport }}
    @Bean
    @ServiceConnection
    MailpitContainer mailpit() {
        return new MailpitContainer("{{ .MailpitImage }}");
    }
{{ end }}
{{- if .RabbitMQSupport }}
    @Bean
    @ServiceConnection
    RabbitMQContainer rabbitmq() {
        return new RabbitMQContainer(parse("{{ .RabbitMQImage }}"));
    }
{{ end }}
{{- if .RedisCachingSupport }}
    @Bean
    @ServiceConnection(name = "redis")
    GenericContainer<?> redis() {
        return new GenericContainer<>(parse("{{ .RedisImage }}")).withExposedPorts(6379);
    }
{{ end }}
}
