services:
  {{- if eq .DbType "PostgreSQL" }}
  postgres:
    image: postgres:18-alpine
    environment:
      - POSTGRES_USER=postgres
      - POSTGRES_PASSWORD=postgres
      - POSTGRES_DB=postgres
    ports:
      - "5432:5432"
  {{- end }}
  {{- if eq .DbType "MySQL" }}
  mysql:
    image: mysql:8.1.0
    environment:
      - MYSQL_DATABASE=test
      - MYSQL_USER=user
      - MYSQL_PASSWORD=secret
      - MYSQL_ROOT_PASSWORD=admin
    ports:
      - "3306:3306"
  {{- end }}
  {{- if eq .DbType "MariaDB" }}
  mariadb:
    image: mariadb:12
    environment:
      - MYSQL_DATABASE=test
      - MYSQL_USER=user
      - MYSQL_PASSWORD=secret
      - MYSQL_ROOT_PASSWORD=admin
    ports:
      - "3306:3306"
  {{- end }}
  {{- if .SpringCloudAWSSupport }}
  floci:
    image: floci/floci:latest-compat
    ports:
      - "4566:4566"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - ./src/test/resources/floci-init/ready.d:/etc/floci/init/ready.d:ro
    environment:
      AWS_DEFAULT_REGION: us-east-1
  {{- end }}

  {{- if .EmailSupport }}
  mailpit:
    image: axllent/mailpit:v1.30
    ports:
      - "1025:1025"
      - "8025:8025"
  {{- end }}

  {{ .ArtifactID }}:
    image: your_dockerhub_username/{{ .ArtifactID }}
    container_name: {{ .ArtifactID }}
    environment:
      SPRING_PROFILES_ACTIVE: docker
      {{- if .EmailSupport }}
      EMAIL_HOST: mailpit
      EMAIL_PORT: 1025
      {{- end }}
      {{- if eq .DbType "PostgreSQL" }}
      SPRING_DATASOURCE_URL: jdbc:postgresql://postgres:5432/postgres
      SPRING_DATASOURCE_USERNAME: postgres
      SPRING_DATASOURCE_PASSWORD: postgres
      {{- end }}
      {{- if eq .DbType "MySQL" }}
      SPRING_DATASOURCE_URL: jdbc:mysql://localhost:3306/test
      SPRING_DATASOURCE_USERNAME: user
      SPRING_DATASOURCE_PASSWORD: secret
      {{- end }}
      {{- if eq .DbType "MariaDB" }}
      SPRING_DATASOURCE_URL: jdbc:mariadb://localhost:3306/test
      SPRING_DATASOURCE_USERNAME: user
      SPRING_DATASOURCE_PASSWORD: secret
      {{- end }}
    ports:
      - "8080:8080"
    depends_on:
      {{- if eq .DbType "PostgreSQL" }}
      - postgres
      {{- end }}
      {{- if eq .DbType "MySQL" }}
      - mysql
      {{- end }}
      {{- if eq .DbType "MariaDB" }}
      - mariadb
      {{- end }}
      {{- if .EmailSupport }}
      - mailpit
      {{- end }}
    restart: unless-stopped
    profiles:
      - app
